# Copy to .env.local and fill in values from Supabase > Connect.
NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=your-publishable-key

# Required for Vercel Production. Use the production site's HTTPS origin.
NEXT_PUBLIC_APP_URL=

# Server-side only. Required for Vercel Production, optional for local development.
OPENAI_API_KEY=your-openai-api-key
OPENAI_MODEL=gpt-6-luna
